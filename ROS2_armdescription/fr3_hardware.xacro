<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

  <xacro:arg name="hand"     default="false"/>
  <xacro:arg name="robot_ip" default="192.168.1.1"/>

  <!-- ── Robot geometry (same as simulation) ───────────────────────────────── -->
  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ros2_control BLOCK — REAL ROBOT
       FrankaHardwareInterface connects to the physical FR3 via libfranka.

       Requirements before launching:
         1. PC on same subnet as robot
         2. FCI enabled: https://<robot_ip> → Settings → Activate FCI
         3. libfranka version matches robot firmware:
            dpkg -l | grep libfranka
  ═══════════════════════════════════════════════════════════════════════ -->
  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>franka_hardware/FrankaHardwareInterface</plugin>
      <param name="robot_ip">$(arg robot_ip)</param>
      <param name="version">0.20.4</param>
      <param name="robot_type">fr3</param>
    </hardware>

    <!-- ── Joints ─────────────────────────────────────────────────────────────
         Interfaces identical to simulation. Initial values are ignored by
         franka_hardware — the real robot reports its actual joint positions.
    ─────────────────────────────────────────────────────────────────────── -->
    <joint name="fr3_joint1">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="fr3_joint2">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-0.785398</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="fr3_joint3">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="fr3_joint4">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-2.356194</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="fr3_joint5">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="fr3_joint6">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.5707963</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="fr3_joint7">
      <command_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.785398</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- ── Franka semantic component sensor ───────────────────────────────────
         Required by franka_robot_state_broadcaster to read robot mode,
         error flags, external torques and O_T_EE from franka_hardware.
    ─────────────────────────────────────────────────────────────────────── -->
    <sensor name="fr3_robot_state">
      <state_interface name="robot_mode"/>
      <state_interface name="errors"/>
      <state_interface name="O_T_EE_0"/>
      <state_interface name="O_T_EE_1"/>
      <state_interface name="O_T_EE_2"/>
      <state_interface name="O_T_EE_3"/>
      <state_interface name="O_T_EE_4"/>
      <state_interface name="O_T_EE_5"/>
      <state_interface name="O_T_EE_6"/>
      <state_interface name="O_T_EE_7"/>
      <state_interface name="O_T_EE_8"/>
      <state_interface name="O_T_EE_9"/>
      <state_interface name="O_T_EE_10"/>
      <state_interface name="O_T_EE_11"/>
      <state_interface name="O_T_EE_12"/>
      <state_interface name="O_T_EE_13"/>
      <state_interface name="O_T_EE_14"/>
      <state_interface name="O_T_EE_15"/>
    </sensor>

  </ros2_control>

  <!-- No <gazebo> plugin block — on the real robot the controller manager
       is a standalone ros2_control_node launched from fr3_real.launch.py.
       The YAML is passed via that node's parameters, not via a Gazebo tag. -->

</robot>